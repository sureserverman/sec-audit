build/
out/
dist/
*.log

# ===== Misc =====
.cache/
*.bak
*.tmp
*.temp
# A PE artifact under tests/fixtures/ is test INPUT, not build output (see the
# Cargo.lock note above). The blanket build/ rule would drop the windows fixture.
!tests/fixtures/vulnerable-windows/build/
!tests/fixtures/vulnerable-windows/build/**
!tests/fixtures/vulnerable-linux/build/
!tests/fixtures/vulnerable-linux/build/**
!tests/fixtures/vulnerable-android/app/build/
!tests/fixtures/vulnerable-android/app/build/**
