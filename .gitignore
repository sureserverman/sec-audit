# ===== Environment & Secrets =====
.env
# ...but tests/fixtures/vulnerable-secrets/.env is a fixture of FAKE canary
# credentials the secrets lane exists to detect. Ignoring it meant every clone
# scanned a tree with less in it than the author's, and said nothing.
!tests/fixtures/**/.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12

# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.tox/
htmlcov/
.coverage
.coverage.*

# ===== Node.js =====
node_modules/
.npm
.yarn/
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ===== Rust =====
target/
Cargo.lock
# ...but a Cargo.lock under tests/fixtures/ is test INPUT, not build output.
# The blanket rule above silently excluded tests/fixtures/depinv/cargo/Cargo.lock,
# so script-depinv passed locally and failed in every clone and on CI.
!tests/fixtures/**/Cargo.lock
# Keep Cargo.lock for binaries, remove this line if building a binary

