        "line": 1,
        "confidence": "high",
        "severity": "CRITICAL",
        "cwe": "CWE-506",
        "reference_url": "https://github.com/ossf/malicious-packages"
      },
      "map": {
        "id": "id",
        "title": "summary",
        "evidence": "summary",
        "file": {
          "concat": [
            {
              "from": "_parent.package.name"
            },
            "@",
