  "tools": [
    {
      "name": "guarddog-npm",
      "probe": "guarddog",
      "applicable_glob": [
        "package.json"
      ],
      "inapplicable_reason": "no-supply-chain-source",
      "invoke": [
        "guarddog",
        "npm",
        "verify",
        "{target}/package.json",
        "--output-format",
        "json"
      ],
      "output": "stdout",
      "sources": [
        {
          "flatten": "result.results",
          "map": {
            "id": "_key",
            "title": "message",
            "evidence": "message",
            "file": {
              "concat": [
                {
                  "from": "_parent.dependency"
                },
                "@",
                {
                  "from": "_parent.version"
                }
              ]
            }
          },
          "filter": {
            "field": "_key",
            "in": [
              "typosquatting",
              "deceptive_author",
              "potentially_compromised_email_domain",
              "unclaimed_maintainer_email_domain",
              "repository_integrity_mismatch"
            ]
          },
          "const": {
            "line": 1,
            "confidence": "medium",
            "severity": "HIGH",
            "cwe": "CWE-1357",
            "reference_url": "https://github.com/DataDog/guarddog"
